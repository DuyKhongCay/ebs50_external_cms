</div>
                            
                            <!-- Modal 5: Config EBS-50 Connection -->
 <div                            class="modal fade" id="configModal" tabindex="-1" aria-hidden="true">
      <div                           class="modal-dialog modal-dialog-centered">
           <div                          class="modal-content">
                <div                         class="modal-header">
                                            <h5 class="modal-title fw-bold">⚙️ Cấu Hình Kết Nối EBS-50 (SFTP)</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                        </div>
                    <div                     class="modal-body">
                         <form id="configForm" onsubmit="return false;">
                              <div                   class="mb-3">
                                                    <label class="form-label fw-semibold">Địa chỉ IP / Hostname EBS-50:</label>
                                                    <input type="text" id="cfgHost" class="form-control" placeholder="192.168.11.36 hoặc ebs50.local" />
                                                </div>
                                 <div                class="row g-2 mb-3">
                                      <div               class="col-md-6">
                                                        <label class="form-label fw-semibold">Cổng SSH (Port):</label>
                                                        <input type="number" id="cfgPort" class="form-control" value="22" />
                                                    </div>
                                          <div           class="col-md-6">
                                                        <label class="form-label fw-semibold">Tên đăng nhập:</label>
                                                        <input type="text" id="cfgUser" class="form-control" value="root" />
                                                    </div>
