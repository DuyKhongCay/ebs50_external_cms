                 <div                        class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                                               
                                                <button type="button" class="btn btn-primary px-4 fw-semibold" onclick="saveConfig()">Lưu Cấu Hình</button>
                                            </div>
                                        </div>
                                    </div>
</div>
                                
  <script>
                                function showAlert(msg, isSuccess = true) {
                                        const box = document.getElementById('alertBox');
                                        const span = document.getElementById('alertMessage');
                                        span.innerText = msg;
                                        box.className = `alert alert-dismissible fade show mb-3 shadow-sm ${isSuccess ? 'alert-success' : 'alert-danger'}`;
                                        box.classList.remove('d-none');
                                        window.scrollTo({ top: 0, behavior: 'smooth' });
    }
                                
                                    // Client-side instant filter on E-Tags table
                                   function filterTagsTable() {
                                        const searchVal = document.getElementById('filterSearch').value.toLowerCase().trim();
                                        const modelVal = document.getElementById('filterModel').value;
        const stateVal = document.getElementById('filterState').value;
                                
                                        const rows = document.querySelectorAll('#tagsTableBody tr');
                        rows.forEach(row => {
                                            const mac = row.getAttribute('data-mac') || '';
                                            const machine = row.getAttribute('data-machine') || '';
                                            const model = row.getAttribute('data-model') || '';
            const state = row.getAttribute('data-state') || '';
                                
                                            const matchSearch = !searchVal || mac.includes(searchVal) || machine.includes(searchVal);
                                            const matchModel = !modelVal || model === modelVal;
            const matchState = !stateVal || state === stateVal;
                                
                                  if (matchSearch && matchModel && matchState) {
                                                row.classList.remove('d-none');
                            } else {
                                                row.classList.add('d-none');
                                            }
                                        });
    }
                                
                                  function resetFilters() {
                                        document.getElementById('filterSearch').value = '';
                                        document.getElementById('filterModel').value = '';
                                        document.getElementById('filterState').value = '';
                                        filterTagsTable();
    }
                                
                                    // Modal 1: Tag preview
             function showTagModal(mac, machine, model) {
                                        document.getElementById('modalTitle').innerText = `Thẻ MAC: ${mac} (Máy: ${machine} - Model: ${model})`;
                                        const timestamp = new Date().getTime();
                                        document.getElementById('modalImg').src = `/api/render/preview/${mac}?_t=${timestamp}`;
                                        const modal = new bootstrap.Modal(document.getElementById('tagModal'));
                                        modal.show();
    }
                                
                                    // Modal 2: Link / ReLink Tag
                  function openLinkModal() {
                                        document.getElementById('linkModalTitle').innerText = '🔗 Ghép Nối Thẻ E-Tag Mới';
                                        document.getElementById('linkMac').value = '';
                                        document.getElementById('linkMac').removeAttribute('readonly');
                                        document.getElementById('linkMachine').value = '';
                                        document.getElementById('linkModelSelect').value = '';
                                        document.getElementById('linkModelCustom').value = '';
                                        document.getElementById('linkModelCustom').classList.add('d-none');
        document.getElementById('linkAutoDispatch').checked = true;
                                
                                        const modal = new bootstrap.Modal(document.getElementById('linkTagModal'));
                                        modal.show();
    }
                                
            function editTagLink(mac, machine, model, state) {
                                        document.getElementById('linkModalTitle').innerText = `✏️ Sửa Ghép Thẻ: ${mac}`;
                                        document.getElementById('linkMac').value = mac;
                                        document.getElementById('linkMac').setAttribute('readonly', 'true');
        document.getElementById('linkMachine').value = machine;
                                
                                        const modelSelect = document.getElementById('linkModelSelect');
                            if ([...modelSelect.options].some(o => o.value === model)) {
                                            modelSelect.value = model;
                                            document.getElementById('linkModelCustom').classList.add('d-none');
                   } else {
                                            modelSelect.value = '__custom__';
                                            document.getElementById('linkModelCustom').value = model;
                                            document.getElementById('linkModelCustom').classList.remove('d-none');
        }
                                
                                        document.getElementById('linkState').value = state;
        document.getElementById('linkAutoDispatch').checked = true;
                                
                                        const modal = new bootstrap.Modal(document.getElementById('linkTagModal'));
                                        modal.show();
    }
                                
              function onLinkModelSelectChange() {
                                        const sel = document.getElementById('linkModelSelect').value;
                                        const customInput = document.getElementById('linkModelCustom');
                                       if (sel === '__custom__') {
                                            customInput.classList.remove('d-none');
                                            customInput.focus();
                              } else {
                                            customInput.classList.add('d-none');
                                        }
    }
                                
              async function submitLinkTag() {
                                        const mac = document.getElementById('linkMac').value.trim().toUpperCase();
                                        const machine = document.getElementById('linkMachine').value.trim();
                                        let model = document.getElementById('linkModelSelect').value;
                                   if (model === '__custom__') {
                                            model = document.getElementById('linkModelCustom').value.trim();
                                        }
                                        const state = parseInt(document.getElementById('linkState').value);
        const autoDispatch = document.getElementById('linkAutoDispatch').checked;
                                
                    if (!mac || !machine || !model) {
                                            alert('Vui lòng điền đầy đủ Địa chỉ MAC, Mã Máy và Model.');
                                            return;
        }
                                
                                        const btn = document.getElementById('btnSubmitLink');
                                        const spinner = document.getElementById('spinnerLink');
                                        btn.disabled = true;
        spinner.classList.remove('d-none');
                                
                         try                {
                          const resp = await fetch('/api/tags/link', {
                                                method: 'POST',
                                                headers: { 'Content-Type': 'application/json' },
                      body: JSON.stringify({
                                                    macAddress: mac,
                                                    machineNo: machine,
                                                    modelCode: model,
                                                    initialStateCode: state,
                                                    autoDispatch: autoDispatch
                                                })
            });
                                
                                            const result = await resp.json();
                    if (resp.ok && result.success) {
                                                bootstrap.Modal.getInstance(document.getElementById('linkTagModal')).hide();
                                                showAlert(result.message, true);
                                                setTimeout(() => window.location.reload(), 1000);
                                      } else {
                                                showAlert(`Lỗi ghép thẻ: ${result.message || JSON.stringify(result)}`, false);
                                            }
                         } catch (err) {
                                            showAlert(`Lỗi mạng: ${err}`, false);
                   } finally {
                                            btn.disabled = false;
                                            spinner.classList.add('d-none');
                                        }
    }
                                
                             async function unlinkTag(mac) {
        if (!confirm(`Bạn có chắc muốn hủy ghép nối và xóa thẻ MAC ${mac} không?`)) return;
                                
                           try              {
                                            const resp = await fetch(`/api/tags/${mac}`, { method: 'DELETE' });
                                            const result = await resp.json();
                       if (resp.ok && result.success) {
                                                const row = document.getElementById(`row-${mac}`);
                                                if (row) row.remove();
                                                showAlert(result.message, true);
                                        } else {
                                                showAlert(`Lỗi: ${result.message}`, false);
                                            }
                           } catch (err) {
                                            showAlert(`Lỗi: ${err}`, false);
                                        }
    }
                                
                                    // Modal 3: State Settings & Icon Upload
        function openStateSettingsModal() {
                                        loadSelectedStateConfig();
                                        const modal = new bootstrap.Modal(document.getElementById('stateSettingsModal'));
                                        modal.show();
    }
                                
                      function loadSelectedStateConfig() {
                                        const sel = document.getElementById('stateSelectConfig');
                                        const opt = sel.options[sel.selectedIndex];
        if (!opt) return;
                                
                                        const isNew = sel.value === '__new__';
                                        const newCodeContainer = document.getElementById('newStateCodeContainer');
                                        const btnSave = document.getElementById('btnSaveState');
                                        const btnDelete = document.getElementById('btnDeleteState');
                                        const btnUpload = document.getElementById('btnUploadIcon');
        const iconLabel = document.getElementById('iconFileInputLabel');
                                
                         if (isNew) {
                                            newCodeContainer.classList.remove('d-none');
                                            // Calculate next available integer code
                     const existingCodes = [...sel.options]
                                                .map(o => parseInt(o.value))
                                                .filter(n => !isNaN(n));
                                            const nextCode = existingCodes.length > 0 ? Math.max(...existingCodes) + 1 : 5;
            document.getElementById('stateCodeNewInput').value = nextCode;
                                
                                            document.getElementById('stateNameViInput').value = '';
                                            document.getElementById('stateNameKoInput').value = '';
                                            document.getElementById('stateThemeColorInput').value = 'Black';
            document.getElementById('stateIconPreview').src = '/api/states/0/icon';
                                
                                            btnSave.innerText = '+ Tạo Trạng Thái Mới';
                                            btnSave.className = 'btn btn-success flex-grow-1 fw-semibold';
                                            btnDelete.classList.add('d-none');
                                            btnUpload.classList.add('d-none');
                                            iconLabel.innerText = 'Chọn icon cho trạng thái mới:';
                                  } else {
                                            newCodeContainer.classList.add('d-none');
            const stateCode = parseInt(sel.value);
                                
                                            document.getElementById('stateNameViInput').value = opt.getAttribute('data-vi') || '';
                                            document.getElementById('stateNameKoInput').value = opt.getAttribute('data-ko') || '';
            document.getElementById('stateThemeColorInput').value = opt.getAttribute('data-color') || 'Black';
                                
            document.getElementById('stateIconPreview').src = `/api/states/${stateCode}/icon?_t=${new Date().getTime()}`;
                                
                                            btnSave.innerText = 'Lưu Thông Tin Trạng Thái';
                                            btnSave.className = 'btn btn-primary flex-grow-1 fw-semibold';
                                            btnUpload.classList.remove('d-none');
            iconLabel.innerText = 'Tải lên icon mới:';
                                
                                  if (stateCode > 4) {
                                                btnDelete.classList.remove('d-none');
                            } else {
                                                btnDelete.classList.add('d-none');
                                            }
                                        }
    }
                                
                                   async function saveStateAction() {
                                        const sel = document.getElementById('stateSelectConfig');
                                 if (sel.value === '__new__') {
                                            await createNewState();
                           } else {
                                            await saveStateMetadata();
                                        }
    }
                                
           async function createNewState() {
                                        const codeInput = document.getElementById('stateCodeNewInput').value.trim();
                                        const nameVi = document.getElementById('stateNameViInput').value.trim();
                                        const nameKo = document.getElementById('stateNameKoInput').value.trim();
                                        const themeColor = document.getElementById('stateThemeColorInput').value;
        const fileInput = document.getElementById('stateIconFileInput');
                                
                          if (!codeInput || isNaN(parseInt(codeInput))) {
                                            alert('Mã trạng thái phải là số nguyên hợp lệ.');
                                            return;
                                        }
              if (!nameVi || !nameKo) {
                                            alert('Vui lòng điền đầy đủ Tên tiếng Việt và Tên tiếng Hàn.');
                                            return;
        }
                                
                                        const formData = new FormData();
                                        formData.append('StateCode', parseInt(codeInput));
                                        formData.append('StateNameVi', nameVi);
                                        formData.append('StateNameKo', nameKo);
        formData.append('ThemeColor', themeColor);
                                
                 if (fileInput.files && fileInput.files.length > 0) {
                                            formData.append('iconFile', fileInput.files[0]);
        }
                                
                                        const btn = document.getElementById('btnSaveState');
                                        btn.disabled = true;
        btn.innerText = 'Đang khởi tạo...';
                                
                            try             {
                             const resp = await fetch('/api/states', {
                                                method: 'POST',
                                                body: formData
            });
                                
                                            const result = await resp.json();
              if (resp.ok && result.success) {
                                                showAlert(result.message, true);
                                                setTimeout(() => window.location.reload(), 1000);
                                   } else {
                                                alert(`Lỗi tạo trạng thái: ${result.message || JSON.stringify(result)}`);
                                            }
                      } catch (err) {
                                            alert(`Lỗi kết nối: ${err}`);
                } finally {
                                            btn.disabled = false;
                                            btn.innerText = '+ Tạo Trạng Thái Mới';
                                        }
    }
                                
                          async function deleteCurrentState() {
                                        const sel = document.getElementById('stateSelectConfig');
                                        const stateCode = parseInt(sel.value);
        if (isNaN(stateCode) || stateCode <= 4) return;
                                
        if (!confirm(`Bạn có chắc muốn xóa Trạng thái [${stateCode}] không?`)) return;
                                
                try                         {
                                            const resp = await fetch(`/api/states/${stateCode}`, { method: 'DELETE' });
                                            const result = await resp.json();
                                        if (resp.ok && result.success) {
                                                showAlert(result.message, true);
                                                setTimeout(() => window.location.reload(), 1000);
                               } else {
                                                alert(`Lỗi xóa trạng thái: ${result.message}`);
                                            }
                  } catch (err) {
                                            alert(`Lỗi kết nối: ${err}`);
                                        }
    }
                                
                               async function saveStateMetadata() {
                                        const stateCode = parseInt(document.getElementById('stateSelectConfig').value);
                                        const nameVi = document.getElementById('stateNameViInput').value.trim();
                                        const nameKo = document.getElementById('stateNameKoInput').value.trim();
        const themeColor = document.getElementById('stateThemeColorInput').value;
                                
                    if (!nameVi || !nameKo) {
                                            alert('Tên tiếng Việt và Hàn không được để trống.');
                                            return;
        }
                                
        try                                 {
                                      const resp = await fetch(`/api/states/${stateCode}`, {
                                                method: 'PUT',
                                                headers: { 'Content-Type': 'application/json' },
                                  body: JSON.stringify({
                                                    stateNameVi: nameVi,
                                                    stateNameKo: nameKo,
                                                    themeColor: themeColor
                                                })
            });
                                
                                            const result = await resp.json();
                                      if (resp.ok && result.success) {
                                                showAlert(result.message, true);
                                                setTimeout(() => window.location.reload(), 1000);
                             } else {
                                                alert(`Lỗi: ${result.message}`);
                                            }
                } catch (err) {
                                            alert(`Lỗi: ${err}`);
                                        }
    }
                                
                              function previewSelectedIconFile(event) {
                                        const file = event.target.files[0];
                            if (file) {
                                            const reader = new FileReader();
                          reader.onload = e => {
                                                document.getElementById('stateIconPreview').src = e.target.result;
                                            };
                                            reader.readAsDataURL(file);
                                        }
    }
                                
                             async function uploadStateIconFile() {
                                        const sel = document.getElementById('stateSelectConfig');
        if (sel.value === '__new__') return;
                                
                                        const stateCode = parseInt(sel.value);
                                        const fileInput = document.getElementById('stateIconFileInput');
                   if (!fileInput.files || fileInput.files.length === 0) {
                                            alert('Vui lòng chọn một file ảnh để tải lên.');
                                            return;
        }
                                
                                        const btn = document.getElementById('btnUploadIcon');
                                        const spinner = document.getElementById('spinnerUploadIcon');
                                        btn.disabled = true;
        spinner.classList.remove('d-none');
                                
                                        const formData = new FormData();
        formData.append('iconFile', fileInput.files[0]);
                                
                  try                       {
                   const resp = await fetch(`/api/states/${stateCode}/icon`, {
                                                method: 'POST',
                                                body: formData
            });
                                
                                            const result = await resp.json();
                                 if (resp.ok && result.success) {
                                                showAlert(result.message, true);
                                                document.getElementById('stateIconPreview').src = `/api/states/${stateCode}/icon?_t=${new Date().getTime()}`;
                                                setTimeout(() => window.location.reload(), 1000);
                     } else {
                                                alert(`Lỗi tải ảnh: ${result.message}`);
                                            }
                                     } catch (err) {
                                            alert(`Lỗi: ${err}`);
                               } finally {
                                            btn.disabled = false;
                                            spinner.classList.add('d-none');
                                        }
    }
                                
                                    // Modal 4: Models Management
          function openModelsModal() {
                                        const modal = new bootstrap.Modal(document.getElementById('modelsModal'));
                                        modal.show();
    }
                                
                           async function addNewModel() {
                                        const code = document.getElementById('newModelCode').value.trim();
                                        const desc = document.getElementById('newModelDesc').value.trim();
                      if (!code) {
                                            alert('Vui lòng nhập Mã Model.');
                                            return;
        }
                                
           try                              {
                                         const resp = await fetch('/api/models', {
                                                method: 'POST',
                                                headers: { 'Content-Type': 'application/json' },
                                                body: JSON.stringify({ modelCode: code, description: desc })
            });
                                
                                            const result = await resp.json();
                       if (resp.ok && result.success) {
                                                showAlert(result.message, true);
                                                setTimeout(() => window.location.reload(), 800);
                                           } else {
                                                alert(`Lỗi: ${result.message}`);
                                            }
                               } catch (err) {
                                            alert(`Lỗi: ${err}`);
                                        }
    }
                                
               async function deleteModel(code) {
        if (!confirm(`Bạn có chắc muốn xóa Model ${code} không?`)) return;
                                
             try                            {
                                            const resp = await fetch(`/api/models/${encodeURIComponent(code)}`, { method: 'DELETE' });
                                            const result = await resp.json();
                                     if (resp.ok && result.success) {
                                                const row = document.getElementById(`model-row-${code}`);
                                                if (row) row.remove();
                                                showAlert(result.message, true);
                         } else {
                                                alert(`Lỗi: ${result.message}`);
                                            }
            } catch (err) {
                                            alert(`Lỗi: ${err}`);
                                        }
    }
                                
                                    // Modal 5: EBS-50 Config & SFTP Test
                      async function openConfigModal() {
                       try                  {
                                            const resp = await fetch('/api/dispatch/config');
                     if (resp.ok) {
                                                const cfg = await resp.json();
                                                document.getElementById('cfgHost').value = cfg.host || '192.168.11.36';
                                                document.getElementById('cfgPort').value = cfg.port || 22;
                                                document.getElementById('cfgUser').value = cfg.username || 'root';
                                                document.getElementById('cfgPass').value = cfg.password || '';
                                                document.getElementById('cfgPath').value = cfg.remotePath || '/home/root/ebs_50_run/Input';
                                            }
                       } catch (e) {
                                            console.error(e);
                                        }
                                        const modal = new bootstrap.Modal(document.getElementById('configModal'));
                                        modal.show();
    }
                                
                              async function saveConfig() {
                               const payload = {
                                            host: document.getElementById('cfgHost').value.trim(),
                                            port: parseInt(document.getElementById('cfgPort').value),
                                            username: document.getElementById('cfgUser').value.trim(),
                                            password: document.getElementById('cfgPass').value,
                                            remotePath: document.getElementById('cfgPath').value.trim()
        };
                                
                                        try {
            const resp = await fetch('/api/dispatch/config', {
                                                method: 'POST',
                                                headers: { 'Content-Type': 'application/json' },
                                                body: JSON.stringify(payload)
                                            });
                                            const data = await resp.json();
                       if (resp.ok) {
                                                bootstrap.Modal.getInstance(document.getElementById('configModal')).hide();
                                                showAlert(data.message, true);
              } else {
                                                alert('Lỗi lưu cấu hình: ' + (data.message || JSON.stringify(data)));
                                            }
                               } catch (e) {
                                            alert('Lỗi kết nối: ' + e);
                                        }
    }
                                
               async function testSftpConnection() {
                                        const btn = document.getElementById('btnTestSftp');
                                        const spinner = document.getElementById('spinnerTest');
                                        btn.disabled = true;
        spinner.classList.remove('d-none');
                                
                                 try        {
                                            const resp = await fetch('/api/dispatch/test-connection', { method: 'POST' });
                                            const result = await resp.json();
                            if (result.success) {
                                                showAlert(`[SFTP Test]: ${result.message}`, true);
                      } else {
                                                showAlert(`[SFTP Test]: ${result.message}`, false);
                                            }
         } catch (err) {
                                            showAlert(`Lỗi kết nối kiểm tra: ${err}`, false);
                                } finally {
                                            btn.disabled = false;
                                            spinner.classList.add('d-none');
                                        }
    }
                                
                                    // Tag Dispatching
          async function dispatchTag(mac) {
                                        const select = document.getElementById(`select-state-${mac}`);
                                        const newState = parseInt(select.value);
        const btn = document.getElementById(`btn-send-${mac}`);
                                
                                        btn.disabled = true;
        btn.innerText = 'Đang gửi...';
                                
                          try               {
                           const resp = await fetch(`/api/tags/${mac}/state`, {
                                                method: 'POST',
                                                headers: { 'Content-Type': 'application/json' },
                                                body: JSON.stringify({ stateCode: newState })
            });
                                
                                            const result = await resp.json();
                                      if (resp.ok && result.success) {
                                                showAlert(result.message, true);
                                                const syncBadge = document.getElementById(`badge-sync-${mac}`);
                                 if (syncBadge) {
                                                    syncBadge.innerText = 'Pending';
                                                    syncBadge.className = 'badge bg-info text-dark';
                                                }
                                                const stateBadge = document.getElementById(`badge-state-${mac}`);
                   if (stateBadge) {
                                                    const themeColor = result.data.themeColor;
                                                    const badgeClass = themeColor === 'Red' ? 'bg-danger' : (themeColor === 'Yellow' ? 'bg-warning text-dark' : 'bg-dark');
                                                    stateBadge.className = `badge ${badgeClass}`;
                                                    stateBadge.innerText = `[${result.data.stateCode}] ${result.data.stateNameVi}`;
                                                }
                          } else {
                                                showAlert(`Lỗi bắn thẻ: ${result.message || JSON.stringify(result)}`, false);
                                            }
             } catch (err) {
                                            showAlert(`Lỗi kết nối: ${err}`, false);
                                     } finally {
                                            btn.disabled = false;
                                            btn.innerText = 'Bắn Thẻ';
                                        }
    }
                                
                  async function syncAllTags() {
        if (!confirm('Bạn có chắc muốn đồng bộ toàn bộ thẻ nhãn ra trạm EBS-50 không?')) return;
                                
                                        const btn = document.getElementById('btnSyncAll');
                                        const spinner = document.getElementById('spinnerSyncAll');
                                        btn.disabled = true;
        spinner.classList.remove('d-none');
                                
                                 try        {
                                            const resp = await fetch('/api/dispatch/send-all', { method: 'POST' });
                                            const data = await resp.json();
                                            showAlert(`Đã đưa toàn bộ ${data.totalTags} thẻ vào hàng đợi gửi SFTP sang router EBS-50!`, true);
                     } catch (err) {
                                            showAlert(`Lỗi: ${err}`, false);
               } finally {
                                            btn.disabled = false;
                                            spinner.classList.add('d-none');
                                        }
    }
                                
                         function updateSimulator() {
                                        const model = encodeURIComponent(document.getElementById('simModel').value || 'A27/M47/F70');
                                        const state = document.getElementById('simState').value;
                                        const color = document.querySelector('input[name="simColor"]:checked')?.value || 'Red';
                                        const timestamp = new Date().getTime();
                                        document.getElementById('simPreviewImg').src = `/api/render/simulate?model=${model}&state=${state}&color=${color}&_t=${timestamp}`;
                                    }
</script>
