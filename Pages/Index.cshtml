                                           <div      class="mb-3">
                                                    <label class="form-label fw-semibold">Mật khẩu SSH (để trống nếu không có):</label>
                                                    <input type="password" id="cfgPass" class="form-control" placeholder="Mật khẩu SSH/SFTP..." />
                                                </div>
                                               <div  class="mb-3">
                                                    <label class="form-label fw-semibold">Thư mục Input trên EBS-50:</label>
                                                    <input type="text" id="cfgPath" class="form-control" value="/home/root/ebs_50_run/Input" />
