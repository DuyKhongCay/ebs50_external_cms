@page
@model IndexModel
@{
    ViewData["Title"] = "E-Tag Manager Dashboard";
}

<div class="container-fluid py-3">
    <!-- Header Section -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 border-bottom pb-3 gap-2">
        <div>
            <h2 class="fw-bold text-primary mb-1">E-Tag EBS-50 CMS Dashboard</h2>
            <p class="text-muted mb-0">Hệ thống quản lý trạng thái máy và thẻ nhãn điện tử Opticon SE420RY (External CMS
                Mode)</p>
            </div>
            <div class="d-flex flex-wrap gap-2 align-items-center">
                <button class="btn btn-primary btn-sm px-3 fw-semibold shadow-sm" onclick="openLinkModal()">
                    🔗 Ghép Thẻ Mới
                </button>
                <button class="btn btn-outline-dark btn-sm px-3 fw-semibold" onclick="openStateSettingsModal()">
                    🎨 Cấu Hình Trạng Thái & Icon
                </button>
                <button class="btn btn-outline-dark btn-sm px-3 fw-semibold" onclick="openModelsModal()">
                    📦 Quản Lý Models
                </button>
                <button class="btn btn-outline-secondary btn-sm px-3 fw-semibold" onclick="openConfigModal()">
                    ⚙️ Cấu Hình EBS-50
                </button>
                <button class="btn btn-outline-info btn-sm px-3 fw-semibold" onclick="testSftpConnection()"
                        id="btnTestSftp">
                    <span id="spinnerTest" class="spinner-border spinner-border-sm d-none me-1"></span>
                    Kiểm Tra SFTP
                </button>
                <button class="btn btn-warning btn-sm px-3 fw-semibold shadow-sm" onclick="syncAllTags()" id="btnSyncAll">
                    <span id="spinnerSyncAll" class="spinner-border spinner-border-sm d-none me-1"></span>
                    Đồng Bộ Tất Cả
                </button>
                <span class="badge bg-success fs-6 px-3 py-2">SQLite Active</span>
            </div>
        </div>

        <!-- Alert Box -->
        <div id="alertBox" class="alert alert-dismissible fade show d-none mb-3 shadow-sm" role="alert">
            <span id="alertMessage"></span>
            <button type="button" class="btn-close"
                    onclick="document.getElementById('alertBox').classList.add('d-none')"></button>
        </div>

        <!-- Summary KPI Cards -->
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card shadow-sm border-0 border-start border-primary border-4">
                    <div class="card-body">
                        <h6 class="text-muted text-uppercase fw-semibold mb-1">Tổng số Thẻ E-Tag</h6>
                        <h2 class="fw-bold mb-0 text-dark" id="kpiTagCount">@Model.Tags.Count</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card shadow-sm border-0 border-start border-success border-4">
                    <div class="card-body">
                        <h6 class="text-muted text-uppercase fw-semibold mb-1">Tổng số Models</h6>
                        <h2 class="fw-bold mb-0 text-dark" id="kpiModelCount">@Model.ModelCount</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card shadow-sm border-0 border-start border-warning border-4">
                    <div class="card-body">
                        <h6 class="text-muted text-uppercase fw-semibold mb-1">Trạng thái máy</h6>
                        <h2 class="fw-bold mb-0 text-dark">@Model.States.Count</h2>
                    </div>
                </div>
            </div>
        </div>

        <!-- Live Render Simulator Card -->
        <div class="card shadow-sm mb-4 border-0 border-top border-primary border-3">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0 text-dark">Live Simulator: Trình Mô Phỏng Hiển Thị E-Paper (400x300)</h5>
                <small class="text-muted">Kiểm tra kết quả render hình ảnh 4 màu (Trắng, Đỏ, Đen, Vàng) theo thời gian
                    thực</small>
                </div>
                <div class="card-body">
                    <div class="row g-4 align-items-center">
                        <div class="col-md-5">
                            <form id="simForm" onsubmit="return false;">
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Model Sản Phẩm:</label>
                                    <input type="text" id="simModel" class="form-control" value="A27/M47/F70"
                                           placeholder="Nhập tên Model..." />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Trạng Thái Máy:</label>
                                    <select id="simState" class="form-select">
                                        @foreach (var state in Model.States)
                                        {
                                            <option value="@state.StateCode">[@state.StateCode] @state.StateNameVi
                                                (@state.StateNameKo)</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold">Màu Chủ Đạo (4 Màu E-Paper):</label>
                                        <div class="d-flex gap-2">
                                            <div class="form-check">
                                                <input class="form-check-input" type="radio" name="simColor" id="colorRed"
                                                       value="Red" checked>
                                                <label class="form-check-label text-danger fw-bold" for="colorRed">Đỏ (Red)</label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input" type="radio" name="simColor" id="colorYellow"
                                                       value="Yellow">
                                                <label class="form-check-label text-warning fw-bold" for="colorYellow">Vàng
                                                    (Yellow)</label>
                                                </div>
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" name="simColor" id="colorBlack"
                                                           value="Black">
                                                    <label class="form-check-label text-dark fw-bold" for="colorBlack">Đen
                                                        (Black)</label>
                                                    </div>
                                                </div>
                                            </div>
                                            <button type="button" class="btn btn-primary px-4 fw-semibold" onclick="updateSimulator()">
                                                Render Thử Nghiệm
                                            </button>
                                        </form>
                                    </div>
                                    <div class="col-md-7 text-center">
                                        <div class="p-3 bg-light border rounded d-inline-block shadow-sm">
                                            <div class="fw-semibold text-muted mb-2 small">Hình ảnh mô phỏng hiển thị trên E-tag SE420RY
                                                (400 x 300 px)</div>
                                                <img id="simPreviewImg" src="/api/render/simulate?model=A27/M47/F70&state=0&color=Red"
                                                     alt="E-tag Live Preview" class="border rounded shadow-sm"
                                                     style="width: 400px; height: 300px; object-fit: contain; background: white;" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- E-Tags Management Card & Filter Toolbar -->
                            <div class="card shadow-sm border-0">
                                <div class="card-header bg-white py-3">
                                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                                        <h5 class="fw-bold mb-0 text-dark">Danh Sách Thẻ Nhãn & Vị Trí Máy</h5>
                                        <span class="text-muted small">Cập nhật trạng thái trực tiếp hoặc qua MES API</span>
                                    </div>

                                    <!-- Filter Toolbar -->
                                    <div class="row g-2 align-items-center">
                                        <div class="col-md-4">
                                            <div class="input-group input-group-sm">
                                                <span class="input-group-text bg-light">🔍</span>
                                                <input type="text" id="filterSearch" class="form-control"
                                                       placeholder="Tìm theo Mã Máy hoặc MAC..." oninput="filterTagsTable()" />
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <select id="filterModel" class="form-select form-select-sm" onchange="filterTagsTable()">
                                                <option value="">-- Tất cả Models --</option>
                                                @foreach (var m in Model.Models)
                                                {
                                                    <option value="@m.ModelCode">@m.ModelCode</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="col-md-3">
                                            <select id="filterState" class="form-select form-select-sm" onchange="filterTagsTable()">
                                                <option value="">-- Tất cả Trạng Thái --</option>
                                                @foreach (var st in Model.States)
                                                {
                                                    <option value="@st.StateCode">[@st.StateCode] @st.StateNameVi</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="col-md-2 text-end">
                                            <button class="btn btn-outline-secondary btn-sm w-100" onclick="resetFilters()">
                                                Xóa Lọc
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <div class="card-body p-0">
                                    <div class="table-responsive">
                                        <table class="table table-hover table-striped align-middle mb-0" id="tagsTable">
                                            <thead class="table-dark">
                                                <tr>
                                                    <th>Địa Chỉ MAC</th>
                                                    <th>Mã Máy / Vị Trí</th>
                                                    <th>Model Đang Chạy</th>
                                                    <th>Trạng Thái Hiện Tại</th>
                                                    <th>Mức Pin</th>
                                                    <th>Lần Gửi Cuối</th>
                                                    <th>Trạng Thái Sync</th>
                                                    <th class="text-center">Xem Trước</th>
                                                    <th class="text-center" style="width: 250px;">Bắn Lệnh Ra Thẻ</th>
                                                    <th class="text-center" style="width: 120px;">Thao Tác</th>
                                                </tr>
                                            </thead>
                                            <tbody id="tagsTableBody">
                                                @foreach (var tag in Model.Tags)
                                                {
                                                    <tr id="row-@tag.MacAddress" data-mac="@tag.MacAddress.ToLowerInvariant()"
                                                        data-machine="@tag.MachineNo.ToLowerInvariant()" data-model="@tag.ModelCode"
                                                        data-state="@tag.CurrentStateCode">
                                                        <td class="font-monospace fw-bold text-primary">@tag.MacAddress</td>
                                                        <td><span class="fw-semibold">@tag.MachineNo</span></td>
                                                        <td><span class="badge bg-secondary" id="model-badge-@tag.MacAddress">@tag.ModelCode</span>
                                                        </td>
                                                        <td>
                                                            @{
                                                                var themeBadge = tag.CurrentState?.ThemeColor == "Red" ? "bg-danger" :
                                                                                 tag.CurrentState?.ThemeColor == "Yellow" ? "bg-warning text-dark" : "bg-dark";
                                                                var stateName = tag.CurrentState?.StateNameVi ?? $"Trạng thái {tag.CurrentStateCode}";
                                                            }
                                                            <span class="badge @themeBadge" id="badge-state-@tag.MacAddress">
                                                                [@tag.CurrentStateCode] @stateName
                                                            </span>
                                                        </td>
                                                        <td>
                                                            <div class="d-flex align-items-center" style="width: 90px;">
                                                                <div class="progress flex-grow-1 me-2" style="height: 6px;">
                                                                    <div class="progress-bar @(tag.BatteryLevel > 20 ? "bg-success" : "bg-danger")"
                                                                         style="width: @(tag.BatteryLevel)%"></div>
                                                                </div>
                                                                <small class="text-muted">@(tag.BatteryLevel)%</small>
                                                            </div>
                                                        </td>
                                                        <td>
                                                            <small class="text-muted font-monospace" id="sync-time-@tag.MacAddress">
                                                                @(tag.LastSyncedAt.HasValue ?
                                                            tag.LastSyncedAt.Value.ToLocalTime().ToString("HH:mm:ss dd/MM") : "--")
                                                            </small>
                                                        </td>
                                                        <td>
                                                            @{
                                                                var syncBadgeClass = tag.SyncStatus switch
                                                                {
                                                                    "Confirmed" => "bg-success",
                                                                    "Synced" => "bg-success",
                                                                    "Uploaded" => "bg-primary",
                                                                    "Dispatching" => "bg-warning text-dark",
                                                                    "Pending" => "bg-info text-dark",
                                                                    "Error" => "bg-danger",
                                                                    _ => "bg-secondary"
                                                                };
                                                            }
                                                         <span class="badge @syncBadgeClass" id="badge-sync-@tag.MacAddress">
                                                                @tag.SyncStatus
                                                            </span>
                                                        </td>
                                            <td             class="text-center">
                                                                   
                                           <button class="btn btn-sm btn-outline-primary" onclick="showTagModal('@tag.MacAddress', '@tag.MachineNo', '@tag.ModelCode')">
                                                                Xem Ảnh
                                                            </button>
                                                        </td>
                                             <td            class="text-center">
                                       <div                      class="input-group input-group-sm">
                                                <select class="form-select form-select-sm" id="select-state-@tag.MacAddress">
                                                                    @foreach (var st in Model.States)
                                                               {     
                                                                                               
                                                               <!option value="@st.StateCode" @(st.StateCode == tag.CurrentStateCode ? "selected" : "")>
                                                                            [@st.StateCode] @st.StateNameVi
                                                                        </!option>
                                                                    }
                                                                </select>
                                                                       
                                                    <button class="btn btn-success btn-sm px-2 fw-semibold" onclick="dispatchTag('@tag.MacAddress')" id="btn-send-@tag.MacAddress">
                                                                    Bắn Thẻ
                                                                </button>
                                                            </div>
                                                        </td>
                                                      <td   class="text-center">
                                                 <div            class="btn-group btn-group-sm">
                                                                       
                                                          <button class="btn btn-outline-secondary btn-sm" title="Sửa ghép nối" onclick="editTagLink('@tag.MacAddress', '@tag.MachineNo', '@tag.ModelCode', @tag.CurrentStateCode)">
                                                                    ✏️
                                                                </button>
                                                                       
                                                           <button class="btn btn-outline-danger btn-sm" title="Hủy ghép thẻ" onclick="unlinkTag('@tag.MacAddress')">
                                                                    🗑️
                                                                </button>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
</div>
                        
                        <!-- Modal 1: Live Preview Image -->
   <div                      class="modal fade" id="tagModal" tabindex="-1" aria-hidden="true">
            <div                 class="modal-dialog modal-dialog-centered">
                     <div            class="modal-content">
                              <div       class="modal-header">
                                        <h5 class="modal-title fw-bold" id="modalTitle">Xem Trước Thẻ Nhãn</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                     <div                class="modal-body text-center bg-light">
                                            
                                        <img id="modalImg" src="" alt="Preview" class="border rounded shadow-sm" style="width: 400px; height: 300px; object-fit: contain; background: white;" />
                                    </div>
                    <div                 class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                                    </div>
                                </div>
                            </div>
</div>
                        
                        <!-- Modal 2: Link / ReLink Tag Modal -->
               <div          class="modal fade" id="linkTagModal" tabindex="-1" aria-hidden="true">
                        <div     class="modal-dialog modal-dialog-centered">
                   <div              class="modal-content">
             <div                        class="modal-header bg-primary text-white">
                                        <h5 class="modal-title fw-bold" id="linkModalTitle">🔗 Ghép Nối Thẻ E-Tag</h5>
                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                    </div>
                                 <div    class="modal-body">
                            <form id="linkForm" onsubmit="return false;">
                      <div                       class="mb-3">
                                                <label class="form-label fw-semibold">Địa chỉ MAC của Thẻ (8 ký tự Hex):</label>
                                                      
                                                <input type="text" id="linkMac" class="form-control font-monospace text-uppercase" placeholder="Ví dụ: B4B819DE" required />
                                                <small class="text-muted">Địa chỉ MAC in trên mặt sau của thẻ Opticon SE420RY</small>
                                            </div>
                      <div                       class="mb-3">
                                                <label class="form-label fw-semibold">Mã Máy / Vị Trí Làm Việc:</label>
                                                      
                                                <input type="text" id="linkMachine" class="form-control" placeholder="Ví dụ: 38 hoặc LINE1-M01" required />
                                            </div>
                               <div              class="mb-3">
                                                <label class="form-label fw-semibold">Model Sản Phẩm:</label>
                              <div                   class="input-group">
                                       <select id="linkModelSelect" class="form-select" onchange="onLinkModelSelectChange()">
                                                        <option value="">-- Chọn Model có sẵn --</option>
                                                        @foreach (var m in Model.Models)
                                            {            
                                                            <option value="@m.ModelCode">@m.ModelCode</option>
                                                        }
                                                        <option value="__custom__">+ Nhập Model mới...</option>
                                                    </select>
                                                </div>
                                                      
                                                <input type="text" id="linkModelCustom" class="form-control mt-2 d-none" placeholder="Nhập tên Model mới..." />
                                            </div>
                               <div              class="mb-3">
                                                <label class="form-label fw-semibold">Trạng Thái Khởi Tạo:</label>
                                             <select id="linkState" class="form-select">
                                                    @foreach (var st in Model.States)
                              {                      
                                                        <option value="@st.StateCode">[@st.StateCode] @st.StateNameVi (@st.StateNameKo)</option>
                                                    }
                                                </select>
                                            </div>
                                 <div            class="form-check mb-3">
                                                <input class="form-check-input" type="checkbox" id="linkAutoDispatch" checked>
                                <label class="form-check-label fw-semibold" for="linkAutoDispatch">
                                                    Tự động render và bắn ngay sang trạm EBS-50 sau khi ghép nối
                                                </label>
                                            </div>
                                        </form>
                                    </div>
                      <div               class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                                               
                 <button type="button" class="btn btn-primary px-4 fw-semibold" onclick="submitLinkTag()" id="btnSubmitLink">
                                            <span id="spinnerLink" class="spinner-border spinner-border-sm d-none me-1"></span>
                                            Lưu Ghép Thẻ
                                        </button>
                                    </div>
                                </div>
                            </div>
</div>
                        
                        <!-- Modal 3: Machine State & Icon Configuration Modal -->
                 <div        class="modal fade" id="stateSettingsModal" tabindex="-1" aria-hidden="true">
                          <div   class="modal-dialog modal-dialog-centered modal-lg">
                     <div            class="modal-content">
               <div                      class="modal-header bg-dark text-white">
                                        <h5 class="modal-title fw-bold">🎨 Cấu Hình Trạng Thái Máy & Icon</h5>
                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body">
                <div                         class="row g-4">
                         <div                    class="col-md-6 border-end">
                                  <div               class="mb-3">
                                                    <label class="form-label fw-semibold">Chọn Trạng Thái Cần Cấu Hình:</label>
                                                <select id="stateSelectConfig" class="form-select" onchange="loadSelectedStateConfig()">
                                                        @foreach (var st in Model.States)
                                 {                       
                                                                   
                                               <option value="@st.StateCode" data-vi="@st.StateNameVi" data-ko="@st.StateNameKo" data-color="@st.ThemeColor" data-icon="@st.IconFileName">
                                                                [@st.StateCode] @st.StateNameVi
                                                            </option>
                                                        }
                                                        <option value="__new__" class="fw-bold text-success">+ Thêm Trạng Thái Mới...</option>
                                                    </select>
                                                </div>
                           <div                      class="mb-3 d-none" id="newStateCodeContainer">
                                                    <label class="form-label fw-semibold text-success">Mã Trạng Thái Mới (Số nguyên):</label>
                                                    <input type="number" id="stateCodeNewInput" class="form-control" min="0" max="999" value="5" />
                                                    <small class="text-muted">Gợi ý mã trạng thái tiếp theo chưa được sử dụng</small>
                                                </div>
                                     <div            class="mb-3">
                                                    <label class="form-label fw-semibold">Tên Trạng Thái (Tiếng V
                                    i                      ệt):</label>
                                                    <input type="text" id="stateNameViInput" class="form-control" placeholder="Ví dụ: Bảo trì định kỳ (PM)..." />
                                                </div>
                                         <div        class="mb-3">
                                                    <label class="form-label fw-semibold">Tên Trạng Thái (Tiếng H
                                                       à   n):</label>
                                                    <input type="text" id="stateNameKoInput" class="form-control" placeholder="Ví dụ: 정기 점검..." />
                                                </div>
                               <div                  class="mb-3">
                                                    <label class="form-label fw-semibold">Màu Chủ Đạo E-Paper:</label>
                                             <select id="stateThemeColorInput" class="form-select">
                                                        <option value="Black">Đen (Black)</option>
                                                        <option value="Red">Đỏ (Red)</option>
                                                        <option value="Yellow">Vàng (Yellow)</option>
                                                    </select>
                                                </div>
                                          <div       class="d-flex gap-2">
                                                           
                                                 <button type="button" class="btn btn-primary flex-grow-1 fw-semibold" id="btnSaveState" onclick="saveStateAction()">
                                                        Lưu Thông Tin Trạng Thái
                                                    </button>
                                                           
                                 <button type="button" class="btn btn-outline-danger fw-semibold d-none" id="btnDeleteState" onclick="deleteCurrentState()">
                                                        🗑️ Xóa
                                                    </button>
                                                </div>
                    </div>
                        
                      <div                       class="col-md-6 text-center">
                                                <label class="form-label fw-semibold d-block mb-2">Ảnh Icon E-Paper (PNG 400x300):</label>
                                    <div             class="p-2 border rounded bg-light mb-3 d-inline-block shadow-sm">
                                                        
                                                        
                                                    <img id="stateIconPreview" src="/api/states/0/icon" alt="Icon Preview" style="width: 240px; height: 180px; object-fit: contain; background: white;" class="border rounded" />
                                                </div>
                        <div                         class="mb-3 text-start">
                                                       
                                                        <label class="form-label small fw-semibold" id="iconFileInputLabel">Tải lên ico
       n                                                        mới:</label>
                                                        <input type="file" id="stateIconFileInput" class="form-control form-control-sm" accept=".png,.jpg,.bmp" onchange="previewSelectedIconFile(event)" />
                                                        <small class="text-muted">Định dạng: PNG tỷ lệ 4:3 (400 x 300 px), nền trắng.</small>
                                                    </div>
                                                           
                             <button type="button" class="btn btn-success w-100 fw-semibold" onclick="uploadStateIconFile()" id="btnUploadIcon">
                                                        <span id="spinnerUploadIcon" class="spinner-border spinner-border-sm d-none me-1"></span>
                                                        Tải Icon Lên Hệ Thống
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                        <div                 class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                                        </div>
                                    </div>
                                </div>
</div>
                            
                            <!-- Modal 4: Models Management Modal -->
                    <div         class="modal fade" id="modelsModal" tabindex="-1" aria-hidden="true">
                         <div        class="modal-dialog modal-dialog-centered">
                              <div       class="modal-content">
                                   <div      class="modal-header bg-dark text-white">
                                            <h5 class="modal-title fw-bold">📦 Quản Lý Danh Mục Models</h5>
                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                        </div>
                                       <div  class="modal-body">
                                            <!-- Add Model Form -->
                <form id="addModelForm" onsubmit="return false;" class="mb-4 p-3 bg-light rounded border">
                                                <h6 class="fw-bold mb-2">Thêm Model Mới:</h6>
                      <div                           class="row g-2 mb-2">
